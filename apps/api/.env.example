# === Duvier API · variables de entorno ===
# La mayoría de estas llaves también se pueden configurar POR NEGOCIO desde el
# panel (Configuración → Integraciones), quedan cifradas en la base de datos.
# Las de aquí abajo funcionan como "modo plataforma" / valores por defecto.

PORT=4000

# Seguridad (cámbialas en producción)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
CREDENTIALS_SECRET=cambia-esto-tambien-por-otro-secreto-largo

# Verify token que configuras en el Webhook de tu App de Meta (Messenger/Instagram)
META_WEBHOOK_VERIFY_TOKEN=duvier-verify-token

# --- IA (opcional a nivel plataforma; normalmente se configura por negocio) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

DATA_DIR=./data
SESSIONS_DIR=./sessions/whatsapp
