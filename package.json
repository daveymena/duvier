{
  "name": "duvier",
  "private": true,
  "version": "0.1.0",
  "description": "Duvier · Plataforma de ventas y marketing con IA para WhatsApp, Messenger, Instagram y Telegram",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
